{
  "schemaVersion": 1,
  "id": "chatting",
  "version": "1.0.1",
  "name": "AetherChatting",
  "description": "Bringing a fresh look to the Minecraft chat, with various improvements and features.",
  "authors": [
    "signal1165"
  ],
  "contact": {
    "sources": "https://github.com/signal1165/AetherChatting"
  },
  "license": "LGPL-3.0-or-later",
  "icon": "assets/chatting/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "value": "org.aetherhaven.chatting.ChattingClient",
        "adapter": "kotlin"
      }
    ],
    "modmenu": [
      {
        "value": "org.aetherhaven.chatting.integration.ChattingModMenuIntegration",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "mixins.chatting.json"
  ],
  "accessWidener": "chatting.ct",
  "depends": {
    "minecraft": "~26.2",
    "fabricloader": ">=0.19.3",
    "aetherconfigv1": ">=1.0.1",
    "fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20"
  },
  "breaks": {
    "chatpatches": "*"
  },
  "contributors": [
    "signal1165"
  ]
}
